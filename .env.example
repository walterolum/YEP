# YouthRise frontend environment configuration
# Copy this file to `.env.local` and adjust as needed. Vite only exposes
# variables prefixed with VITE_ to the browser, so never place secrets here.

# Base path for the Spring Boot API. Keep the default when the API is served
# behind the same origin (for example, through a reverse proxy at /api).
VITE_API_BASE_URL=/api

# Demonstration mode. When true (the default), every service call is served
# from the in-browser demo store and no network requests are made.
# Set to false only when a real API is available at VITE_API_BASE_URL.
VITE_DEMO_MODE=true
